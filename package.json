{
  "name": "volt-spectra",
  "version": "1.0.0",
  "private": true,
  "description": "VOLT-SPECTRA — Contactless AC Grid Frequency & THD Analyzer, EMF Vampire-Load Hunter, Optical Smart-Meter Tachometer & TOU Bill Auditor. Polyglot: Angular 19 Signals + ANSI C99 DSP + Ruby 3.3 + GraphQL SDL + GLSL.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "embed": "node scripts/embed-sources.mjs",
    "prebuild": "node scripts/embed-sources.mjs",
    "build": "ng build",
    "predev": "node scripts/embed-sources.mjs",
    "dev": "ng serve --host 0.0.0.0",
    "start": "ng serve --host 0.0.0.0",
    "c99:test": "node scripts/test-c99.mjs",
    "test:parity": "node scripts/test-bridge-parity.mjs",
    "test:graphql": "node scripts/test-graphql-sdl.mjs",
    "test": "npm run c99:test && npm run test:parity && npm run test:graphql",
    "vercel-build": "npm run build && node scripts/inject-config.mjs"
  },
  "dependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/router": "19.2.25",
    "@supabase/supabase-js": "^2.119.2",
    "graphql": "16.11.0",
    "idb": "8.0.4",
    "qrcode": "1.5.4",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular/build": "19.2.25",
    "@angular/cli": "19.2.25",
    "@angular/compiler-cli": "19.2.25",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "typescript": "5.8.3"
  }
}
