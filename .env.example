# Supabase cloud-sync credentials (public anon key — safe to ship in the APK).
# Copy to .env.local for `ng dev`, or set them as Vercel project env vars.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional build-time fallback (see src/environments/environment.prod.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
